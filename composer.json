{
    "name": "angeom21/frappe-laravel-bridge",
    "description": "Frappe API Bridge for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Angeom21",
            "email": "angeom@example.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Angeom\\FrappeBridge\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Angeom\\FrappeBridge\\FrappeBridgeServiceProvider"
            ],
            "aliases": {
                "Frappe": "Angeom\\FrappeBridge\\Facades\\Frappe"
            }
        }
    }
}
